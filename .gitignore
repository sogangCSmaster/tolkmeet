# ── 빌드 결과 ─────────────────────────────
**/target/
**/node_modules/
web/dist/
web/.vite/
# scripts/dev.sh 상태·로그, 화면 캡처 결과
.dev/
shots/

# ── 비밀정보·로컬 설정 (예시 파일만 커밋) ──
.env
.env.*
!.env.example
*.pem
*.key
server/.dev-host-password
# SQLite 데이터(계정·세션·회의). 운영 데이터는 Litestream으로 S3에 백업한다
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
server/data/
# 로컬 개발 서버 설정: 개발용 주최자 계정 해시가 들어 있다
.claude/launch.json
.claude/settings.local.json

# ── 측정 산출물 (make-fixtures.sh 로 다시 만든다) ──
bench/gemini/fixtures/
bench/gemini/results/

# ── OS·에디터 ─────────────────────────────
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# 소개 페이지(site/) 빌드 결과
site/dist/
site/.astro/

# 가격 정책·원가 분석 (공개하지 않음)
docs/private/
