# 비밀이 아닌 운영 설정. 비밀값은 /etc/tolkmeet/secrets.env(1Password에서 넣음)와 turn.env(서버에서 생성)에 있다.
BIND_ADDR=127.0.0.1:8080
TRUSTED_PROXY=1
APP_ORIGIN=https://meet.tolkmeet.com
DATABASE_PATH=/var/lib/tolkmeet/tolkmeet.db
CLOUDFLARE_ACCOUNT_ID=e7c0660cceaa56716fbe1bd5e9b01c4a
MAIL_FROM=Tolkmeet <no-reply@tolkmeet.com>
ICE_SERVERS=[{"urls":"stun:meet.tolkmeet.com:3478"}]
TURN_URLS=turn:meet.tolkmeet.com:3478?transport=udp turn:meet.tolkmeet.com:3478?transport=tcp
RUST_LOG=info
# Gemini 하루(UTC) 추정 지출 상한(USD). 넘으면 모든 회의의 자막을 멈추고 운영자에게 메일을 보낸다. 다음 UTC 날짜에 풀린다.
DAILY_SPEND_LIMIT_USD=20
