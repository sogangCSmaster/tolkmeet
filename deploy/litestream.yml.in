# DB를 S3로 계속 복제한다(Litestream 0.5). 처리방침대로 백업 사본은 하루 안에 지워지도록 보관 기간을 24시간으로 둔다.
snapshot:
  interval: 6h
  retention: 24h

# 변경분은 1분마다 모아 올린다(올리는 횟수·요금을 묶는다). 서버가 통째로 사라지면 마지막 1분까지 잃을 수 있다.
sync-interval: 1m

dbs:
  - path: /var/lib/tolkmeet/tolkmeet.db
    replica:
      type: s3
      bucket: @BUCKET@
      path: tolkmeet
      region: ap-northeast-2
