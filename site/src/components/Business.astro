---
// 바닥에 두는 사업자 정보 한 줄. 상호는 영문, 대표·주소는 그 페이지 언어로(한국어가 아니면 영문).
import { COMPANY, companyFor } from '../site'
import type { Dict } from '../i18n/en'

interface Props {
  dict: Dict
  class?: string
}
const { dict, class: className } = Astro.props
const b = dict.biz
const local = companyFor(dict.lang)
---
<p class={className}>
  {b.name} {COMPANY.name} · {b.rep} {local.rep} · {b.regNo} {COMPANY.regNo} · {b.address} {local.address}{b.country} · {b.email} <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
</p>
