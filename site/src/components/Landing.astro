---
// 소개 페이지(design/v2/source/MainFull.dc.html). 밝은 화면만 쓰고, 스크립트 없이 CSS 애니메이션만 쓴다.
import type { Dict } from '../i18n/en'
import Base from '../layouts/Base.astro'
import { COMPANY, GITHUB_URL, legalLinks, LOCALES, SIGN_IN_URL, SIGNUP_URL, SITE_URL } from '../site'
import Business from './Business.astro'
import Gemini from './Gemini.astro'
import Mark from './Mark.astro'
import '../styles/landing.css'

interface Props { t: Dict }
const { t } = Astro.props
const LEGAL = legalLinks(t.lang)
const people = { me: { name: t.meName, lang: t.lang }, other: { name: t.otherName, lang: t.otherLang } }
const initial = (name: string) => [...name][0]
const [h0, , h2] = t.history
// 개인정보 장면: 글자마다 조금씩 늦게 나타났다가 흩어진다. 줄마다 4초씩 차례로(한 바퀴 12초).
// 띄어 쓰는 말은 낱말 단위로 묶어 낱말 중간에서 줄이 바뀌지 않게 한다(띄어 쓰지 않는 일본어는 글자마다 바뀔 수 있다).
type Word = { space: boolean; chars: { c: string; d: string }[] }
const words = (text: string, start: number, step: number) => {
  const out: Word[] = []
  ;[...text].forEach((c, i) => {
    const ch = { c, d: `animation-delay: ${(start + i * step).toFixed(3)}s` }
    const last = out[out.length - 1]
    if (c === ' ') out.push({ space: true, chars: [] })
    else if (!text.includes(' ') || !last || last.space) out.push({ space: false, chars: [ch] })
    else last.chars.push(ch)
  })
  return out
}
const privacyLines = t.privacyLines.map((l, k) => ({
  who: people[l.who],
  src: l.src,
  tr: l.tr,
  d: `animation-delay: ${k * 4}s`,
  srcWords: words(l.src[1], k * 4, 0.02),
  trWords: words(l.tr[1], k * 4, 0.035),
}))
const dots = Array.from({ length: 8 }, (_, i) => i)

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Tolkmeet',
    url: new URL(t.path, SITE_URL).href,
    description: t.metaDescription,
    applicationCategory: 'CommunicationApplication',
    operatingSystem: 'Web browser',
    inLanguage: t.lang,
    offers: t.plans.map((p) => ({ '@type': 'Offer', name: p.name, price: p.price.replace('$', ''), priceCurrency: 'USD', priceSpecification: { '@type': 'UnitPriceSpecification', price: p.price.replace('$', ''), priceCurrency: 'USD', unitCode: 'MON' } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: t.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
]
---
<Base t={t} jsonLd={jsonLd} lightOnly>
  <a class="skip" href="#main">{t.skipToContent}</a>
  <header class="nav">
    <nav class="nav-in" aria-label={t.navLabel}>
      <a class="nav-brand" href={t.path} aria-label="Tolkmeet"><Mark size={22} />tolkmeet</a>
      <ul class="nav-links">
        <li><a href="#how">{t.navHow}</a></li>
        <li><a href="#modes">{t.navModes}</a></li>
        <li><a href="#privacy">{t.navPrivacy}</a></li>
        <li><a href="#pricing">{t.navPricing}</a></li>
        <li><a href="#faq">{t.navFaq}</a></li>
      </ul>
      {/* 언어 선택: 스크립트 없이 열고 닫히는 메뉴. 각 언어는 진짜 링크다. */}
      <details class="lang">
        <summary aria-label={`${t.languageLabel}: ${t.langName}`}>
          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" /></svg>
          <span class="lang-cur">{t.langName}</span>
          <svg width="10" height="10" viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4.5 6 7.5 9 4.5" /></svg>
        </summary>
        <ul class="lang-menu">
          {LOCALES.map((l) => <li><a href={l.path} hreflang={l.lang} lang={l.lang} aria-current={l.lang === t.lang ? 'page' : undefined}>{l.langName}</a></li>)}
        </ul>
      </details>
      <a class="nav-signin" href={SIGN_IN_URL}>{t.signIn}</a>
      <a class="nav-cta" href={SIGNUP_URL}>{t.getStarted}</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero">
      <Mark size={64} />
      <h1 class="hero-title">{t.heroTitle1}<br />{t.heroTitle2}</h1>
      <p class="hero-lead">{t.heroLead}</p>
      <div class="hero-cta">
        <a class="btn btn-cta" href={SIGNUP_URL}>{t.getStarted}</a>
        <a class="hero-more" href="#how">{t.heroSecondary}<span aria-hidden="true"> ›</span></a>
      </div>
      <p class="hero-price">{t.heroPrice}</p>
      <p class="gem-pill"><Gemini id="gem-hero" /><span>{t.poweredBy} <b>Gemini</b></span></p>
    </section>

    {/* 회의 예시: 앱의 회의 화면과 같은 모양(상대 타일, 내 타일, 대화 기록). 최신 줄이 가장 크고 진하다. */}
    <section id="how" class="demo" aria-label={t.demoLabel}>
      <div class="demo-frame">
        <div class="demo-screen" role="img" aria-label={t.demoAlt}>
          <div class="demo-tile">
            <span class="avatar avatar-lg speaking" lang={people.other.lang} aria-hidden="true">{initial(people.other.name)}</span>
            <span class="demo-name" lang={people.other.lang}>{people.other.name}</span>
          </div>
          <div class="demo-tile">
            <span class="avatar avatar-lg" lang={people.me.lang} aria-hidden="true">{initial(people.me.name)}</span>
            <span class="demo-name" lang={people.me.lang}>{people.me.name}</span>
          </div>
          <div class="hist">
            <div class="hist-head"><b>{t.historyTitle}</b><span class="hist-live"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>{t.historyListening}</span></div>
            <div class="hist-lines">
              {t.history.map((h, i) => (
                <div class={`hl hl-${i}`}>
                  <p class="hl-meta"><b lang={people[h.who].lang}>{people[h.who].name}</b><time>{h.time}</time></p>
                  <p class="hl-src" lang={h.src[0]}>{h.src[1]}</p>
                  <p class="hl-tr"><i aria-hidden="true"></i><span lang={h.tr[0]}>{h.tr[1]}</span></p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="statement">
      <p>{t.statement1} <span>{t.statement2}</span></p>
    </section>

    <section class="feature" aria-labelledby="f1">
      <div class="feature-text">
        <h2 id="f1" class="h-feature">{t.featureTitle1}<br />{t.featureTitle2}</h2>
        <p class="lead-21">{t.featureBody}</p>
      </div>
      <div class="feature-card" role="img" aria-label={t.featureAlt}>
        {t.featureLines.map((l, i) => (
          <div class={`fl fl-${i}`}>
            <p class="fl-src" lang={l.src[0]}>{l.src[1]}</p>
            <p class="fl-tr" lang={l.tr[0]}>{l.tr[1]}</p>
          </div>
        ))}
      </div>
    </section>

    {/* 번역 엔진: 속도(스트리밍)와 품질(맥락) */}
    <section id="engine" class="sec" aria-labelledby="engine-title">
      <div class="engine-head">
        <p class="engine-eyebrow"><Gemini id="gem-engine" size={28} />{t.poweredBy} Gemini</p>
        <h2 id="engine-title" class="h-xl">{t.engineTitle1}<br /><span class="gem-text">{t.engineTitle2}</span></h2>
        <p class="lead-21 engine-lead">{t.engineLead}</p>
      </div>
      <div class="engine-cards">
        <div class="speed-card">
          <div>
            <p class="eyebrow eyebrow-dark">{t.speedEyebrow}</p>
            <p class="speed-title">{t.speedTitle}</p>
            <p class="speed-body">{t.speedBody}</p>
          </div>
          <div class="speed-rows" aria-hidden="true">
            {t.speedRows.map(([label, text], i) => (
              <div class={`sr sr-${i}`}>
                <span class="sr-label">{label}</span>
                <span class="sr-text" lang={i === 0 ? t.speedSrcLang : t.lang}>{i > 0 && <i></i>}{text}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="context-card">
          <div>
            <p class="eyebrow">{t.contextEyebrow}</p>
            <p class="context-title">{t.contextTitle1}<br />{t.contextTitle2}</p>
            <p class="body-17">{t.contextBody}</p>
          </div>
          <div class="context-sample">
            <p class="cs-q"><span lang={t.contextQ[0]}>{t.contextQ[1]}</span> → <b lang={t.contextA[0]}>{t.contextA[1]}</b></p>
            <p class="cs-tr" lang={t.contextTr[0]}><i aria-hidden="true"></i>{t.contextTr[1]}</p>
          </div>
        </div>
      </div>
    </section>

    <section id="modes" class="sec" aria-labelledby="modes-title">
      <h2 id="modes-title" class="h-lg center">{t.modesTitle}</h2>
      <p class="lead-21 modes-lead">{t.modesLead}</p>
      <div class="modes-grid">
        <div class="mode mode-video">
          <div class="mode-video-text">
            <p class="eyebrow eyebrow-dark">{t.modeVideo.eyebrow}</p>
            <h3 class="mode-video-title">{t.modeVideo.title1}<br />{t.modeVideo.title2}</h3>
            <p class="mode-video-body">{t.modeVideo.body}</p>
          </div>
          <div class="vm" aria-hidden="true">
            <div class="vm-tile"><span class="avatar avatar-md speaking" lang={people.other.lang}>{initial(people.other.name)}</span><span lang={people.other.lang}>{people.other.name}</span></div>
            <div class="vm-tile"><span class="avatar avatar-md" lang={people.me.lang}>{initial(people.me.name)}</span><span lang={people.me.lang}>{people.me.name}</span></div>
            <div class="hist hist-mini">
              <div class="hist-head"><b>{t.historyTitle}</b><span class="hist-live"><span class="bars"><i></i><i></i><i></i></span>{t.historyListening}</span></div>
              <div class="hist-lines">
                {[h0, h2].map((h, i) => (
                  <div class={`hl hm-${i}`}>
                    <p class="hl-meta"><b lang={people[h.who].lang}>{people[h.who].name}</b><time>{h.time}</time></p>
                    <p class="hl-src" lang={h.src[0]}>{h.src[1]}</p>
                    <p class="hl-tr"><i></i><span lang={h.tr[0]}>{h.tr[1]}</span></p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="mode mode-light">
          <div>
            <p class="eyebrow">{t.modeInPerson.eyebrow}</p>
            <h3 class="mode-title">{t.modeInPerson.title1}<br />{t.modeInPerson.title2}</h3>
            <p class="body-17 mode-body">{t.modeInPerson.body}</p>
          </div>
          {/* 휴대폰 하나: 위쪽 반은 마주 앉은 상대를 향해 뒤집혀 있다 */}
          <div class="phone" aria-hidden="true">
            <div class="phone-top"><span class="ph-src" lang={t.phoneTop.src[0]}>{t.phoneTop.src[1]}</span><span class="ph-tr" lang={t.phoneTop.tr[0]}>{t.phoneTop.tr[1]}</span></div>
            <div class="phone-bottom"><span class="ph-src" lang={t.phoneBottom.src[0]}>{t.phoneBottom.src[1]}</span><span class="ph-tr" lang={t.phoneBottom.tr[0]}>{t.phoneBottom.tr[1]}</span><span class="ph-btn">{t.phoneButton}</span></div>
          </div>
        </div>

        <div class="mode mode-light">
          <div>
            <p class="eyebrow">{t.modeCaptions.eyebrow}</p>
            <h3 class="mode-title">{t.modeCaptions.title1}<br />{t.modeCaptions.title2}</h3>
            <p class="body-17 mode-body">{t.modeCaptions.body}</p>
          </div>
          <div class="tablet" aria-hidden="true">
            <p class="tb-0" lang={t.tabletPast[0][0]}>{t.tabletPast[0][1]}</p>
            <p class="tb-1" lang={t.tabletPast[1][0]}>{t.tabletPast[1][1]}</p>
            <div><p class="tb-src" lang={t.tabletNow.src[0]}>{t.tabletNow.src[1]}</p><p class="tb-tr" lang={t.tabletNow.tr[0]}>{t.tabletNow.tr[1]}</p></div>
          </div>
        </div>
      </div>
    </section>

    <section class="sec" aria-labelledby="details-title">
      <h2 id="details-title" class="h-md">{t.detailsTitle}</h2>
      <ul class="details">
        {t.details.map((d) => (
          <li>
            <h3>{d.title}</h3>
            <p class="body-17">{d.body}</p>
          </li>
        ))}
      </ul>
    </section>

    {/* 개인정보: 자막이 글자마다 나타났다가 흩어져 사라진다(저장하지 않음). 신호 점만 두 사람 사이를 오간다. */}
    <section id="privacy" class="privacy" aria-labelledby="privacy-title">
      <h2 id="privacy-title" class="h-xl">{t.privacyTitle1}<br />{t.privacyTitle2}</h2>
      <p class="privacy-lead">{t.privacyLead}</p>
      <div class="pv-stage">
        {/* 계속 도는 움직임이라 멈출 수 있게 한다(WCAG 2.2.2). 스크립트 없이 체크 상자로. */}
        <input class="pv-pause sr-only" type="checkbox" id="pv-pause" />
        <div class="pv-scene" role="img" aria-label={t.privacyStageLabel}>
          <div class="pv-lines">
            {privacyLines.map((l) => (
              <div class="pv-line" aria-hidden="true">
                <p class="pv-src"><b class="pv-ch" lang={l.who.lang} style={l.d}>{l.who.name}</b>{'\u00a0\u00a0'}<span lang={l.src[0]}>{l.srcWords.map((w) => (w.space ? ' ' : <span class="pv-w">{w.chars.map((x) => <span class="pv-ch" style={x.d}>{x.c}</span>)}</span>))}</span></p>
                <p class="pv-tr"><i class="pv-ch" style={l.d}></i><span lang={l.tr[0]}>{l.trWords.map((w) => (w.space ? ' ' : <span class="pv-w">{w.chars.map((x) => <span class="pv-ch" style={x.d}>{x.c}</span>)}</span>))}</span></p>
              </div>
            ))}
          </div>
          <div class="pv-people" aria-hidden="true">
            <div class="pv-person"><span class="avatar avatar-sm speaking" lang={people.me.lang}>{initial(people.me.name)}</span><span lang={people.me.lang}>{people.me.name}</span></div>
            <div class="pv-mid">
              <div class="pv-wire">
                <span class="pv-wire-line"></span>
                {dots.map((i) => <i class="pv-dot" style={`animation-delay: ${(-0.45 * i).toFixed(2)}s`}></i>)}
                {dots.map((i) => <i class="pv-dot pv-rev" style={`animation-delay: ${(-0.2 - 0.45 * i).toFixed(2)}s`}></i>)}
              </div>
              <span class="pv-wire-label"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2.5" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>{t.privacyWire}</span>
            </div>
            <div class="pv-person"><span class="avatar avatar-sm" lang={people.other.lang}>{initial(people.other.name)}</span><span lang={people.other.lang}>{people.other.name}</span></div>
          </div>
        </div>
        <ul class="pv-chips">
          {t.privacyChips.map(([a, b, c]) => <li class="pv-chip">{a}<b>{b}</b>{c}</li>)}
        </ul>
        <label class="pv-toggle" for="pv-pause">
          <svg class="i-pause" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path fill="currentColor" d="M3 2h2v8H3zM7 2h2v8H7z" /></svg>
          <svg class="i-play" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path fill="currentColor" d="M3 1.8v8.4L10 6z" /></svg>
          {t.privacyPause}
        </label>
      </div>
      <a class="privacy-link" href={LEGAL.privacy} hreflang={LEGAL.lang}>{t.privacyLink}<span aria-hidden="true"> ›</span></a>
    </section>

    <section id="pricing" class="sec" aria-labelledby="pricing-title">
      <h2 id="pricing-title" class="h-lg center">{t.pricingTitle}</h2>
      <p class="pricing-lead">{t.pricingLead}</p>
      <div class="plans">
        {t.plans.map((p, i) => (
          <div class="plan">
            <h3>{p.name}</h3>
            <p class="plan-price">{p.price}<span>{p.unit}</span></p>
            <p class="plan-note">{p.note}</p>
            <a class={`btn plan-cta ${i === 0 ? 'btn-cta' : 'btn-ink'}`} href={SIGNUP_URL}>{p.cta}</a>
          </div>
        ))}
      </div>
      <p class="pricing-fine">{t.pricingFine}</p>
    </section>

    <section id="faq" class="sec faq" aria-labelledby="faq-title">
      <h2 id="faq-title" class="h-md">{t.faqTitle}</h2>
      {t.faq.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <section class="closing">
      <Mark size={72} />
      <p class="h-xl closing-title">{t.closingTitle1}<br />{t.closingTitle2}</p>
      <a class="btn btn-cta closing-cta" href={SIGNUP_URL}>{t.getStarted}</a>
    </section>
  </main>

  <footer class="ft">
    <div class="ft-in">
      <p class="ft-note">{t.footerDisclaimer}</p>
      <div class="ft-rule"></div>
      <div class="ft-cols">
        <div class="ft-brand">
          <span class="ft-logo"><Mark size={20} />tolkmeet</span>
          <span class="ft-tag">{t.heroTitle1}<br />{t.heroTitle2}</span>
          <a class="ft-gh" href={GITHUB_URL}><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" /></svg>{t.footerGithub}</a>
        </div>
        <nav class="ft-col" aria-labelledby="ft-product">
          <span id="ft-product" class="ft-h">{t.footerProduct}</span>
          <a href="#modes">{t.modeVideo.eyebrow}</a>
          <a href="#modes">{t.modeInPerson.eyebrow}</a>
          <a href="#modes">{t.modeCaptions.eyebrow}</a>
          <a href="#pricing">{t.navPricing}</a>
        </nav>
        <nav class="ft-col" aria-labelledby="ft-support">
          <span id="ft-support" class="ft-h">{t.footerSupport}</span>
          <a href="#faq">{t.navFaq}</a>
          <a href={`mailto:${COMPANY.email}`}>{t.footerContact}</a>
        </nav>
        <nav class="ft-col" aria-labelledby="ft-company">
          <span id="ft-company" class="ft-h">{t.footerCompany}</span>
          <a href={GITHUB_URL}>GitHub (AGPL-3.0)</a>
          <a href="#privacy">{t.footerSecurity}</a>
        </nav>
        <nav class="ft-col" aria-labelledby="ft-legal">
          <span id="ft-legal" class="ft-h">{t.footerLegal}</span>
          <a href={LEGAL.privacy} hreflang={LEGAL.lang}>{t.legalPrivacy}</a>
          <a href={LEGAL.terms} hreflang={LEGAL.lang}>{t.legalTerms}</a>
          <a href={LEGAL.refund} hreflang={LEGAL.lang}>{t.legalRefund}</a>
        </nav>
      </div>
      <div class="ft-rule"></div>
      <div class="ft-bottom">
        <div class="ft-id">
          <p>© 2026 <span lang={t.lang === 'ko' ? undefined : 'ko'}>{COMPANY.name}</span>. {t.footerRights}</p>
          <Business dict={t} class="ft-biz" />
        </div>
        <p class="ft-langs">
          {LOCALES.map((l) => <a href={l.path} hreflang={l.lang} lang={l.lang} aria-current={l.lang === t.lang ? 'page' : undefined}>{l.langName}</a>)}
        </p>
      </div>
    </div>
  </footer>
</Base>
