---
import type { Dict } from '../i18n/en'
import Base from '../layouts/Base.astro'
import { GITHUB_URL, legalLinks, LOCALES, SIGN_IN_URL, SIGNUP_URL, SITE_URL } from '../site'
import Business from './Business.astro'
import Face from './Face.astro'
import Gemini from './Gemini.astro'
import Mark from './Mark.astro'

interface Props { t: Dict }
const { t } = Astro.props
const LEGAL = legalLinks(t.lang)
const you = (name: string) => t.you.replace('{name}', name)
const names = { other: t.otherName, me: you(t.meName) }
const nameLang = { other: t.otherNameLang, me: t.lang }
const times = ['15:21', '15:22', '15:22']
// 띄어 쓰지 않는 언어(일본어)는 문구에 | 로 나눠 둔다
const words = t.statement.includes('|') ? t.statement.split('|') : t.statement.split(' ')
const joiner = t.statement.includes('|') ? '' : ' '
// 개인정보 장면: 글자마다 조금씩 늦게 나타나게 지연을 정한다. 줄마다 4초씩 차례로(한 바퀴 12초).
const chars = (text: string, start: number, step: number) => [...text].map((c, i) => ({ c: c === ' ' ? '\u00a0' : c, d: `${(start + i * step).toFixed(3)}s` }))
const privacyLines = t.privacyLines.map((l, k) => ({ ...l, name: l.who === 'me' ? t.meName : t.otherName, nameLang: l.who === 'me' ? t.lang : t.otherNameLang, src: chars(l.text, k * 4, 0.02), out: chars(l.tr, k * 4, 0.035), d: `${k * 4}s` }))
const dots = Array.from({ length: 8 }, (_, i) => i)

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Tolkmeet',
    url: new URL(t.path, SITE_URL).href,
    description: t.metaDescription,
    applicationCategory: 'CommunicationApplication',
    operatingSystem: 'Web browser',
    inLanguage: t.lang,
    offers: t.plans.map((p) => ({ '@type': 'Offer', name: p.name, price: p.price.replace('$', ''), priceCurrency: 'USD', priceSpecification: { '@type': 'UnitPriceSpecification', price: p.price.replace('$', ''), priceCurrency: 'USD', unitCode: 'MON' } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: t.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
]
---
<Base t={t} jsonLd={jsonLd}>
  <a class="skip" href="#main">{t.skipToContent}</a>
  <header class="top">
    <div class="wrap top-row">
      <a class="brand" href={t.path} aria-label="Tolkmeet"><Mark size={28} /><span>tolkmeet</span></a>
      <nav class="top-nav" aria-label={t.navLabel}>
        <a href="#story">{t.navStory}</a>
        <a href="#modes">{t.navModes}</a>
        <a href="#privacy">{t.navPrivacy}</a>
        <a href="#pricing">{t.navPricing}</a>
        <a href="#faq">{t.navFaq}</a>
      </nav>
      <div class="top-actions">
        <nav class="langs" aria-label={t.languageLabel}>
          {LOCALES.map((l) => <a href={l.path} hreflang={l.lang} lang={l.lang} aria-current={l.lang === t.lang ? 'page' : undefined}>{l.langName}</a>)}
        </nav>
        <button class="theme-btn" type="button" data-theme-cycle
          data-labels={JSON.stringify({ system: t.themeSystem, light: t.themeLight, dark: t.themeDark, label: t.themeLabel })}
          aria-label={`${t.themeLabel}: ${t.themeSystem}`}>
          <svg class="i-system" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H4z M9 20h6 M12 16v4" /></svg>
          <svg class="i-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" /></svg>
          <svg class="i-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
        </button>
        <a class="link-quiet" href={SIGN_IN_URL}>{t.signIn}</a>
        <a class="btn btn-cta" href={SIGNUP_URL}>{t.getStarted}</a>
      </div>
    </div>
  </header>

  <main id="main">
    {/* 첫 화면: 로고처럼 두 줄 — 둘째 줄이 비켜 서고 앞에 주황 막대. 페이지가 열릴 때 이 순서로 한 번만 움직인다. */}
    <section class="hero wrap">
      <h1 class="pair-title">
        <span class="pt-1">{t.heroLine1}</span>
        <span class="pt-2"><i class="pt-bar" aria-hidden="true"></i>{t.heroLine2}</span>
      </h1>
      <p class="lead hero-in">{t.heroLead}</p>
      <div class="hero-cta hero-in">
        <a class="btn btn-cta btn-lg" href={SIGNUP_URL}>{t.getStarted}</a>
        <a class="btn btn-plain btn-lg" href="#story">{t.heroSecondary}</a>
      </div>
      <p class="hero-price hero-in">{t.heroPrice}</p>
      <p class="gem-pill hero-in"><Gemini id="gem-hero" /><span>{t.poweredBy} <b>Gemini</b></span></p>
      <ul class="hero-points hero-in">
        {t.heroPoints.map(([a, b]) => (
          <li><span>{a}</span><span class="tr-mark">{b}</span></li>
        ))}
      </ul>
    </section>

    {/* 문제 제기: 스크롤해 내려가는 만큼 낱말이 하나씩 진해진다(읽는 속도에 맞춘 강조). */}
    <section class="statement wrap" data-statement>
      <p>{words.map((w, i) => <><span class="w">{w}</span>{i < words.length - 1 ? joiner : ''}</>)}</p>
    </section>

    {/* 스크롤 장면: 회의 화면이 화면에 머물고, 스크롤한 만큼 대화가 진행된다(말 → 중간 번역 → 확정). */}
    <section id="story" class="story" data-scrub="story" aria-label={t.navStory}>
      <div class="story-pin">
        <div class="wrap story-grid">
          <ol class="story-steps">
            {t.storySteps.map((s, i) => (
              <li class={i === 0 ? 'is-active' : ''} data-step={i}>
                <h2>{s.title}</h2>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
          <div class="meeting" role="img" aria-label={t.storyLabel}>
            <div class="meeting-tiles">
              <div class="tile" data-tile="other"><Face who={t.otherFace} /><span class="tile-name" lang={t.otherNameLang}>{t.otherName}</span></div>
              <div class="tile" data-tile="me"><Face who={t.meFace} /><span class="tile-name">{you(t.meName)}</span></div>
            </div>
            <div class="meeting-panel">
              <div class="panel-head">
                <b>{t.panelTitle}</b>
                <span class="panel-langs"><span lang={t.panelLangs[0][0]}>{t.panelLangs[0][1]}</span> ⇄ <span lang={t.panelLangs[1][0]}>{t.panelLangs[1][1]}</span></span>
              </div>
              <div class="panel-feed">
                {t.story.map((u, i) => (
                  <div class="entry" data-entry={i}>
                    <p class="entry-meta"><b lang={nameLang[u.who]}>{names[u.who]}</b><time>{times[i]}</time></p>
                    <p lang={u.lang} data-src>{u.text}</p>
                    <p class="tr-mark" lang={u.trLang} data-tr>{u.tr}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
      <script type="application/json" data-story set:html={JSON.stringify({ story: t.story, translating: t.translating })} />
    </section>

    {/* 번역 엔진: 속도(스트리밍)와 품질(맥락). */}
    <section id="engine" class="wrap section engine" aria-labelledby="engine-title">
      <div class="engine-head">
        <p class="engine-eyebrow"><Gemini id="gem-engine" size={28} />Powered by Gemini</p>
        <h2 id="engine-title" class="engine-title">{t.engineTitle1}<br /><span class="gem-text">{t.engineTitle2}</span></h2>
        <p class="section-lead">{t.engineLead}</p>
      </div>
      <div class="engine-cards">
        <div class="speed-card">
          <div>
            <p class="eyebrow">{t.speedEyebrow}</p>
            <p class="speed-title">{t.speedTitle}</p>
            <p class="card-body">{t.speedBody}</p>
          </div>
          <ol class="speed-rows" aria-hidden="true">
            {t.speedRows.map(([label, text], i) => (
              <li class={`speed-row r${i}`}><span class="speed-label">{label}</span><span class={i ? 'tr-mark' : ''} lang={i ? t.lang : t.speedSrcLang}>{text}</span></li>
            ))}
          </ol>
        </div>
        <div class="context-card">
          <div>
            <p class="eyebrow">{t.contextEyebrow}</p>
            <p class="context-title">{t.contextTitle1}<br />{t.contextTitle2}</p>
            <p class="card-body">{t.contextBody}</p>
          </div>
          <div class="context-sample">
            <p><span lang={t.contextQ[0]}>{t.contextQ[1]}</span> → <b lang={t.contextA[0]}>{t.contextA[1]}</b></p>
            <p class="tr-mark" lang={t.contextTr[0]}>{t.contextTr[1]}</p>
          </div>
        </div>
      </div>
    </section>

    {/* 세 가지 자리: 기기 화면이 머물고, 스크롤에 따라 화상 → 대면 → 자막 화면으로 바뀐다. */}
    <section id="modes" class="modes" data-scrub="modes" aria-labelledby="modes-title">
      <div class="modes-pin">
        <div class="wrap">
          <h2 id="modes-title" class="section-title">{t.modesTitle}</h2>
          <div class="modes-grid">
            {t.modes.map((m, i) => (
              <article class={`mode${i === 0 ? ' is-active' : ''}`} data-mode={i}>
                <div class={`device device-${i}`} aria-hidden="true">
                  {i === 0 && (
                    <div class="mock-video">
                      <div class="mv-tiles"><div class="tile"><Face who="sakura" /></div><div class="tile"><Face who="minjun" /></div></div>
                      <div class="mv-panel"><i></i><i class="tr"></i><i></i><i class="tr"></i></div>
                    </div>
                  )}
                  {i === 1 && (
                    <div class="mock-phone">
                      <div class="mp-half far"><span lang="ko">네, 감사합니다.</span><small class="tr-mark" lang="ja">はい、ありがとうございます。</small></div>
                      <div class="mp-half"><span lang="ja">はい、ありがとうございます。</span><small class="tr-mark" lang="ko">네, 감사합니다.</small></div>
                    </div>
                  )}
                  {i === 2 && (
                    <div class="mock-tablet">
                      <div class="mt-line"><small lang="ja">本日はありがとうございます。</small><span class="tr-mark" lang="ko">오늘 감사합니다.</span></div>
                      <div class="mt-line"><small lang="ko">먼저 소개해 드릴게요.</small><span class="tr-mark" lang="ja">まずご紹介します。</span></div>
                      <div class="mt-line dim"><small lang="ja">予算について</small><span class="tr-mark" lang="ko">예산에 대해</span></div>
                    </div>
                  )}
                </div>
                <div class="mode-text">
                  <span class="mode-bars" aria-hidden="true">{t.modes.map((_, k) => <i class={k === i ? 'on' : ''}></i>)}</span>
                  <h3>{m.title}</h3>
                  <p>{m.body}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="details-title">
      <h2 id="details-title" class="section-title">{t.detailsTitle}</h2>
      <dl class="details">
        {t.details.map((d) => (
          <div>
            <dt>{d.title}</dt>
            <dd>{d.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    {/* 개인정보: 자막이 나타났다가 흩어져 사라진다(남기지 않음). 두 사람 사이엔 암호화된 신호 점만 오간다. CSS 애니메이션뿐(스크립트 없음). */}
    <section id="privacy" class="privacy" aria-labelledby="privacy-title">
      <div class="wrap">
        <h2 id="privacy-title" class="privacy-title">{t.privacyTitle1}<br />{t.privacyTitle2}</h2>
        <p class="privacy-lead">{t.privacyLead}</p>
        <div class="pv-stage" data-pv>
          <div class="pv-scene" role="img" aria-label={t.privacyStageLabel}>
          <div class="pv-lines" aria-hidden="true">
            {privacyLines.map((l) => (
              <div class="pv-line">
                <p class="pv-src"><b class="pv-ch" lang={l.nameLang} style={`--d:${l.d}`}>{l.name}</b>{'\u00a0\u00a0'}<span lang={l.lang}>{l.src.map((x) => <span class="pv-ch" style={`--d:${x.d}`}>{x.c}</span>)}</span></p>
                <p class="pv-tr"><i class="pv-ch" style={`--d:${l.d}`}></i><span lang={l.trLang}>{l.out.map((x) => <span class="pv-ch" style={`--d:${x.d}`}>{x.c}</span>)}</span></p>
              </div>
            ))}
          </div>
          <div class="pv-people" aria-hidden="true">
            <div class="pv-person"><span class="pv-avatar on" lang={t.lang}>{[...t.meName][0]}</span><span>{t.meName}</span></div>
            <div class="pv-mid">
              <div class="pv-wire">
                <span class="pv-line-bg"></span>
                {dots.map((i) => <i class="pv-dot" style={`--d:${(-0.45 * i).toFixed(2)}s`}></i>)}
                {dots.map((i) => <i class="pv-dot pv-rev" style={`--d:${(-0.2 - 0.45 * i).toFixed(2)}s`}></i>)}
              </div>
              <span class="pv-wire-label">{t.privacyWire}</span>
            </div>
            <div class="pv-person"><span class="pv-avatar" lang={t.otherNameLang}>{[...t.otherName][0]}</span><span lang={t.otherNameLang}>{t.otherName}</span></div>
          </div>
          </div>
          <ul class="pv-chips">
            {t.privacyChips.map(([a, b, c]) => <li class="pv-chip">{a}<b>{b}</b>{c}</li>)}
          </ul>
          {/* 계속 도는 움직임이라 멈출 수 있게 한다(WCAG 2.2.2). */}
          <button class="pv-toggle" type="button" data-pv-toggle data-labels={JSON.stringify({ pause: t.privacyPause, play: t.privacyPlay })}>{t.privacyPause}</button>
        </div>
        <a class="privacy-link" href={LEGAL.privacy} hreflang={LEGAL.lang}>{t.privacyLink} ›</a>
      </div>
    </section>

    <section id="pricing" class="wrap section" aria-labelledby="pricing-title">
      <h2 id="pricing-title" class="section-title">{t.pricingTitle}</h2>
      <p class="section-lead">{t.pricingLead}</p>
      {/* 넓은 화면: 요금제 두 장 + 포함 항목 한 칸. 중간 폭: 두 장 아래에 포함 항목. 휴대폰: 한 줄씩. */}
      <div class="pricing-grid">
        {t.plans.map((p, i) => (
          <div class={`plan${i === 0 ? ' plan-main' : ''}`}>
            <h3>{p.name}</h3>
            <p class="plan-price"><span>{p.price}</span><small>{p.unit}</small></p>
            <p class="plan-hours">{p.hours}</p>
            <p class="plan-note">{p.note}</p>
            <a class={`btn ${i === 0 ? 'btn-cta' : 'btn-ink'}`} href={SIGNUP_URL}>{p.cta}</a>
          </div>
        ))}
        <div class="includes">
          <h3>{t.includesTitle}</h3>
          <ul>{t.includes.map((x) => <li class="tr-mark">{x}</li>)}</ul>
          <p class="plans-extra">{t.pricingExtra}</p>
          <p class="plans-fine">{t.pricingFine}</p>
        </div>
      </div>
    </section>

    <section id="faq" class="wrap section" aria-labelledby="faq-title">
      <h2 id="faq-title" class="section-title">{t.faqTitle}</h2>
      <div class="faq">
        {t.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="wrap closing" data-reveal>
      <p class="pair-title closing-title">
        <span class="pt-1">{t.closingLine1}</span>
        <span class="pt-2"><i class="pt-bar" aria-hidden="true"></i>{t.closingLine2}</span>
      </p>
      <a class="btn btn-cta btn-lg" href={SIGNUP_URL}>{t.getStarted}</a>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-grid">
      <div class="foot-brand">
        <a class="brand" href={t.path} aria-label="Tolkmeet"><Mark size={24} /><span>tolkmeet</span></a>
        <p>{t.footerCopyright}</p>
      </div>
      <nav aria-label={t.footerProduct}>
        <h2>{t.footerProduct}</h2>
        <a href="#story">{t.navStory}</a>
        <a href="#modes">{t.navModes}</a>
        <a href="#pricing">{t.navPricing}</a>
        <a href="#faq">{t.navFaq}</a>
        <a href={SIGN_IN_URL}>{t.signIn}</a>
      </nav>
      <nav aria-label={t.footerLegal}>
        <h2>{t.footerLegal}</h2>
        <a href={LEGAL.privacy} hreflang={LEGAL.lang}>{t.legalPrivacy}</a>
        <a href={LEGAL.terms} hreflang={LEGAL.lang}>{t.legalTerms}</a>
        <a href={LEGAL.refund} hreflang={LEGAL.lang}>{t.legalRefund}</a>
      </nav>
      <div class="foot-col">
        <h2 id="foot-lang">{t.languageLabel}</h2>
        <ul class="foot-list" aria-labelledby="foot-lang">
          {LOCALES.map((l) => <li><a href={l.path} hreflang={l.lang} lang={l.lang} aria-current={l.lang === t.lang ? 'page' : undefined}>{l.langName}</a></li>)}
        </ul>
      </div>
      <div class="foot-col">
        <h2>{t.footerOpenSource}</h2>
        <a class="foot-gh" href={GITHUB_URL} rel="noopener">
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          {t.footerGithub}
        </a>
      </div>
    </div>
    <p class="wrap foot-note">{t.footerDisclaimer}</p>
    <Business dict={t} class="wrap foot-biz" />
  </footer>

  <script is:inline>
    ;(() => {
      const d = document.documentElement

      // ── 테마: 시스템 → 라이트 → 다크 순서로 바꾼다. 선택은 이 브라우저에만 저장한다.
      const btn = document.querySelector('[data-theme-cycle]')
      const labels = JSON.parse(btn.dataset.labels)
      const current = () => d.dataset.theme || 'system'
      const show = () => { btn.dataset.current = current(); btn.setAttribute('aria-label', `${labels.label}: ${labels[current()]}`); btn.title = btn.getAttribute('aria-label') }
      show()
      btn.addEventListener('click', () => {
        const next = { system: 'light', light: 'dark', dark: 'system' }[current()]
        if (next === 'system') delete d.dataset.theme
        else d.dataset.theme = next
        try { next === 'system' ? localStorage.removeItem('tolkmeet.theme') : localStorage.setItem('tolkmeet.theme', next) } catch {}
        show()
      })

      if (!d.classList.contains('motion')) return

      // ── 스크롤 장면. 고정 구역마다 진행률(0~1)을 계산해 그 구역의 그리기 함수에 넘긴다.
      const clamp = (v) => Math.min(1, Math.max(0, v))
      const storyEl = document.querySelector('[data-scrub="story"]')
      const modesEl = document.querySelector('[data-scrub="modes"]')
      const data = JSON.parse(storyEl.querySelector('[data-story]').textContent)
      const entries = [...storyEl.querySelectorAll('[data-entry]')].map((el) => ({ el, src: el.querySelector('[data-src]'), tr: el.querySelector('[data-tr]'), last: '' }))
      const steps = [...storyEl.querySelectorAll('[data-step]')]
      const tiles = { other: storyEl.querySelector('[data-tile="other"]'), me: storyEl.querySelector('[data-tile="me"]') }
      const modes = [...modesEl.querySelectorAll('[data-mode]')]
      const header = document.querySelector('.top')
      const n = data.story.length
      const START = 0.06, SPAN = 0.86 / n

      function drawStory(p) {
        let speaking = null
        let step = 0
        data.story.forEach((u, i) => {
          const e = entries[i]
          const local = (p - START - i * SPAN) / SPAN
          const visible = local >= 0
          e.el.classList.toggle('off', !visible)
          if (!visible) return
          step = i
          const chars = [...u.text]
          const typed = clamp(local / 0.5)
          const pending = local < 0.72
          let tr
          if (typed < 1) {
            const k = Math.floor(typed * (u.drafts.length + 1)) - 1
            tr = k >= 0 ? u.drafts[k] : data.translating
          } else tr = pending ? u.drafts[u.drafts.length - 1] : u.tr
          const src = chars.slice(0, Math.max(1, Math.ceil(typed * chars.length))).join('')
          const key = src + '|' + tr + '|' + pending
          if (key !== e.last) {
            e.last = key
            e.src.textContent = src
            e.tr.textContent = tr
            e.el.classList.toggle('pending', pending)
            e.el.classList.toggle('typing', typed < 1)
          }
          if (typed < 1) speaking = u.who
        })
        // 설명 단계: 첫 문장 = 받아 적기, 번역이 나오기 시작하면 = 번역, 마지막 문장 = 맥락
        const firstTr = (p - START) / SPAN >= 0.5
        const idx = step >= n - 1 ? 2 : firstTr ? 1 : 0
        steps.forEach((s, i) => s.classList.toggle('is-active', i === idx))
        tiles.other.classList.toggle('speaking', speaking === 'other')
        tiles.me.classList.toggle('speaking', speaking === 'me')
      }

      function drawModes(p) {
        const idx = Math.min(modes.length - 1, Math.floor(p * modes.length))
        modes.forEach((m, i) => m.classList.toggle('is-active', i === idx))
      }

      const privacyEl = document.getElementById('privacy')
      const statementEl = document.querySelector('[data-statement]')
      const statementWords = [...statementEl.querySelectorAll('.w')]
      let lit = -1
      const meetingEl = storyEl.querySelector('.meeting')
      const stepsEl = storyEl.querySelector('.story-steps')
      const set = (el, name, value) => { if (el.style.getPropertyValue(name) !== value) el.style.setProperty(name, value) }
      let ticking = false
      function frame() {
        ticking = false
        // 읽기를 먼저 모두 하고(레이아웃 1번), 그다음 쓴다. 값이 바뀔 때만 쓴다.
        const vh = innerHeight
        const sr = storyEl.getBoundingClientRect()
        const mr = modesEl.getBoundingClientRect()
        const hh = header.offsetHeight
        const tr = statementEl.firstElementChild.getBoundingClientRect()
        if (sr.bottom > -vh && sr.top < vh * 2) {
          const p = clamp(-sr.top / (sr.height - vh))
          // 다가오는 동안(0→1): 회의 화면이 기울어진 채 떠오르다 평평해진다
          set(meetingEl, '--a', clamp(1 - sr.top / vh).toFixed(3))
          set(stepsEl, '--p', p.toFixed(3))
          drawStory(p)
        }
        if (mr.bottom > -vh && mr.top < vh * 2) drawModes(clamp(-mr.top / (mr.height - vh)))
        // 문장 윗줄이 화면 85% 높이에 닿으면 시작하고, 마지막 줄이 화면 55% 높이에 오면 다 진해진다(머리말에 가리기 전에 끝난다)
        const k = Math.round(clamp((vh * 0.85 - tr.top) / (tr.height + vh * 0.3)) * statementWords.length)
        if (k !== lit) { lit = k; statementWords.forEach((w, i) => w.classList.toggle('on', i < k)) }
        header.classList.toggle('scrolled', scrollY > 8)
        // 어두운 회의 장면 위를 지나는 동안 머리도 어둡게(흐린 회색으로 비치지 않게)
        const pr = privacyEl.getBoundingClientRect()
        header.classList.toggle('on-dark', (sr.top <= hh && sr.bottom >= hh) || (pr.top <= hh && pr.bottom >= hh))
      }
      const request = () => { if (!ticking) { ticking = true; requestAnimationFrame(frame) } }
      addEventListener('scroll', request, { passive: true })
      addEventListener('resize', request)
      frame()

      // 개인정보 장면: 화면에 보일 때만 움직이고(안 보이면 그리지 않게), 버튼으로 멈출 수 있다.
      const pv = document.querySelector('[data-pv]')
      const pvToggle = pv.querySelector('[data-pv-toggle]')
      const pvLabels = JSON.parse(pvToggle.dataset.labels)
      new IntersectionObserver(([x]) => pv.classList.toggle('pv-run', x.isIntersecting)).observe(pv)
      pvToggle.addEventListener('click', () => {
        const paused = pv.classList.toggle('pv-paused')
        pvToggle.textContent = paused ? pvLabels.play : pvLabels.pause
      })

      // 마지막 문장: 화면에 들어오면 한 번 두 줄이 맞춰 선다
      const io = new IntersectionObserver((list) => list.forEach((x) => { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target) } }), { threshold: 0.4 })
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el))
    })()
  </script>
</Base>
