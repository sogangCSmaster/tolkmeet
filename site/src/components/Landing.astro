  {/* 로더(빌드 후 페이지에 인라인, 1KB 안팎): 카드에 처음 다가가면 움직임 모듈을 미리 받고, 누르면 연다.
      터치 화면(hover 없음)은 한 번 누르면 카드가 뒤집히고 다 뒤집히면 장면이 열린다(마우스의 올리기 → 누르기를 한 번에).
      카드 목록이 처음 보이면 첫 카드가 살짝 뒤집혔다 돌아와 뒤집히는 카드임을 알린다. */}
  <script>
    const list = document.querySelector<HTMLElement>('.details')
    const src = document.querySelector<HTMLTemplateElement>('#mo-src')?.content.querySelector('script')?.getAttribute('src')
    if (list && src) {
      let ready: Promise<unknown> | undefined
      // import() 대신 script 요소로 받는다(번들러가 import()에 붙이는 미리 받기 도우미 없이 로더가 작게 인라인된다).
      // 받기에 실패하면(네트워크 등) 다음 시도에서 다시 받는다.
      const load = () => (ready ??= new Promise((done, fail) => {
        const s = document.createElement('script')
        s.type = 'module'
        s.src = src
        s.onload = done
        s.onerror = () => { s.remove(); ready = undefined; fail(new Error(`failed to load ${src}`)) }
        document.head.append(s)
      }))
      const warm = () => void load().catch(console.error)
      list.addEventListener('pointerover', warm, { once: true })
      list.addEventListener('focusin', warm, { once: true })
      const touch = matchMedia('(hover: none)')
      const still = matchMedia('(prefers-reduced-motion: reduce)')
      const first = list.querySelector('li')
      if (touch.matches && first) {
        const io = new IntersectionObserver((es) => {
          if (!es[0].isIntersecting) return
          io.disconnect()
          warm()
          if (!still.matches) first.classList.add('dt-peek')
        }, { threshold: 0.8 })
        io.observe(first)
      }
      list.addEventListener('click', (e) => {
        const card = (e.target as Element).closest('li')
        if (!card) return
        const open = () => load().then(() => card.dispatchEvent(new Event('mo-open', { bubbles: true })), console.error)
        if (touch.matches && !still.matches && !card.classList.contains('is-flip')) {
          card.classList.add('is-flip')
          warm()
          setTimeout(open, 650)
          return
        }
        open()
      })
    }
  </script>
  {/* 만나는 방식 카드(빌드 후 인라인, 2KB 안팎): 마우스를 올리면(터치 화면은 카드가 화면에 보이면) data-live-turns의 말을
      한 마디씩 넣는다. 글자가 흘러 들어오고 테두리가 숨 쉬는 움직임은 CSS 전환이, 줄이 위 칸으로 옮겨 가는 움직임은
      Web Animations가 맡아서 매 프레임 도는 스크립트가 없다. 대화가 끝나면 처음 화면으로 돌아가 다시 이어 간다. */}
  <script>
    type Said = [string, string]
    type Turn = { who?: 'me' | 'other'; time?: string; name?: { name: string; lang: string }; src: Said; tr: Said }
    type At = (s: number, f: () => void) => void

    const cards = document.querySelectorAll<HTMLElement>('[data-live]')
    if (cards.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const TEXT = '.hist-lines, .ph-src, .ph-tr, .tb-feed'
      const cjk = (text: string) => /[぀-ヿ㐀-鿿가-힯]/.test(text)
      // 한글·가나·한자는 글자마다, 띄어 쓰는 글(영어)은 낱말마다 흘러 들어온다.
      const parts = (text: string) => (cjk(text) ? [...text] : text.split(/(?<=\s)/))
      // 말하는 동안 번역이 함께 나온다: 원문은 실제 말하는 빠르기(글자당 0.09초, 낱말당 0.25초)로 흘러 들어오고,
      // 번역은 LAG초 뒤에 시작해 원문이 끝난 직후에 끝나도록 빠르기를 맞춘다. ds·dt는 원문·번역이 흘러 들어오는 데 걸리는 초.
      const LAG = 0.5
      const timing = ({ src: [, text] }: Turn) => {
        const ds = parts(text).length * (cjk(text) ? 0.09 : 0.25)
        return { ds, dt: Math.max(ds + 0.25 - LAG, 0.6) }
      }
      // 줄을 숨긴 글자 조각으로 채운다. dur초 동안 차례로 나타난다(lv-on).
      const fill = (el: HTMLElement, [lang, text]: Said, dur: number) => {
        const list = parts(text)
        el.lang = lang
        el.classList.add('lv-s')
        el.classList.remove('lv-on')
        el.style.setProperty('--lv-step', `${Math.round((dur * 1000) / list.length)}ms`)
        el.replaceChildren(...list.map((part, i) => {
          const s = document.createElement('span')
          s.className = 'lv-c'
          s.style.setProperty('--i', String(i))
          s.textContent = part
          return s
        }))
      }
      const on = (el: Element) => el.classList.add('lv-on')
      // 위 칸으로 옮겨 간 줄: 원래 있던 자리(dy만큼 아래)에서 원래 진하기(o)로 출발해 미끄러져 올라온다.
      const rise = (el: HTMLElement, dy: number, o: number) =>
        el.animate([{ transform: `translateY(${dy}px)`, opacity: o, offset: 0 }], { duration: 600, easing: 'cubic-bezier(.2,.8,.2,1)' })
      const fadeIn = (els: Iterable<Element>) => {
        for (const el of els) el.animate([{ opacity: 0, offset: 0 }], { duration: 300, easing: 'ease-out' })
      }
      const fadeOut = (els: Iterable<Element>) => [...els].map((el) => el.animate([{ opacity: 0 }], { duration: 250, easing: 'ease-out', fill: 'forwards' }))

      // 한 마디를 넣고, 다음 마디까지의 초를 돌려준다.
      const steps: Record<string, (card: HTMLElement, turn: Turn, at: At) => number> = {
        // 화상 회의: 줄이 한 칸씩 위로 올라가고, 말하는 사람 테두리가 켜진 채 새 줄의 원문과 번역이 함께 흘러 들어온다.
        video(card, turn, at) {
          const vm = card.querySelector<HTMLElement>('.vm')!
          const old = vm.querySelector<HTMLElement>('.hm-0')!
          const cur = vm.querySelector<HTMLElement>('.hm-1')!
          const older = vm.querySelector<HTMLElement>('.hm-x')!
          const from = [old.offsetTop, cur.offsetTop]
          older.innerHTML = old.innerHTML
          older.hidden = false
          old.innerHTML = cur.innerHTML
          const who = cur.querySelector<HTMLElement>('.hl-meta b')!
          who.lang = turn.name!.lang
          who.textContent = turn.name!.name
          cur.querySelector('time')!.textContent = turn.time!
          const src = cur.querySelector<HTMLElement>('.hl-src')!
          const tr = cur.querySelector<HTMLElement>('.hl-tr span')!
          const { ds, dt } = timing(turn)
          fill(src, turn.src, ds)
          fill(tr, turn.tr, dt)
          rise(older, from[0] - older.offsetTop, 0.5)
          rise(old, from[1] - old.offsetTop, 1)
          fadeIn(cur.querySelectorAll('.hl-meta, .hl-tr i'))
          vm.querySelectorAll('.avatar').forEach((av, k) => av.classList.toggle('speaking', (k === 0) === (turn.who === 'other')))
          at(0.2, () => vm.classList.add('lv-talk'))
          at(0.35, () => on(src))
          at(0.35 + LAG, () => on(tr))
          at(0.45 + ds, () => vm.classList.remove('lv-talk'))
          return 0.35 + LAG + dt + 1.9
        },
        // 대면 대화: 말하는 사람 쪽 반의 가장자리가 켜지고, 듣는 사람 쪽 반에 원문과 번역이 함께 흘러 들어온다.
        phone(card, turn, at) {
          const me = turn.who === 'me'
          const half = card.querySelector<HTMLElement>(me ? '.phone-top' : '.phone-bottom')!
          const talker = card.querySelector<HTMLElement>(me ? '.phone-bottom' : '.phone-top')!
          const src = half.querySelector<HTMLElement>('.ph-src')!
          const tr = half.querySelector<HTMLElement>('.ph-tr')!
          const out = fadeOut([src, tr])
          const { ds, dt } = timing(turn)
          at(0.1, () => talker.classList.add('lv-talk'))
          at(0.3, () => {
            out.forEach((x) => x.cancel())
            fill(src, turn.src, ds)
            fill(tr, turn.tr, dt)
          })
          at(0.4, () => on(src))
          at(0.4 + LAG, () => on(tr))
          at(0.5 + ds, () => talker.classList.remove('lv-talk'))
          return 0.4 + LAG + dt + 1.7
        },
        // 자막 화면: 자막이 한 칸씩 올라가고(지난 자막은 번역만 남는다), 새 자막의 원문과 번역이 함께 흘러 들어온다.
        tablet(card, turn, at) {
          const tb = card.querySelector<HTMLElement>('.tablet')!
          const p0 = tb.querySelector<HTMLElement>('.tb-0')!
          const p1 = tb.querySelector<HTMLElement>('.tb-1')!
          const src = tb.querySelector<HTMLElement>('.tb-src')!
          const tr = tb.querySelector<HTMLElement>('.tb-tr')!
          const from = [p1.offsetTop, tr.offsetTop]
          p0.lang = p1.lang
          p0.textContent = p1.textContent
          p1.lang = tr.lang
          p1.textContent = tr.textContent
          const { ds, dt } = timing(turn)
          fill(src, turn.src, ds)
          fill(tr, turn.tr, dt)
          rise(p0, from[0] - p0.offsetTop, 0.6)
          rise(p1, from[1] - p1.offsetTop, 1)
          const feed = tb.querySelector<HTMLElement>('.tb-feed')!
          feed.classList.toggle('lv-over', feed.scrollHeight > feed.clientHeight + 1)
          at(0.3, () => on(src))
          at(0.3 + LAG, () => on(tr))
          return 0.3 + LAG + dt + 2.1
        },
      }

      const runs = new Map<HTMLElement, () => void>()
      const start = (card: HTMLElement) => {
        const step = steps[card.dataset.live ?? '']
        if (runs.has(card) || !step) return
        const turns: Turn[] = JSON.parse(card.dataset.liveTurns ?? '[]')
        const screen = card.querySelector<HTMLElement>('.vm, .phone, .tablet')!
        const first = screen.innerHTML
        const timers: number[] = []
        const at: At = (s, f) => void timers.push(window.setTimeout(f, s * 1000))
        let i = 0
        let dirty = false
        // 처음 화면으로 되돌린다(바뀐 글은 버리고 원래 글을 흐리게 다시 보인다).
        const reset = () => {
          screen.getAnimations({ subtree: true }).forEach((x) => x.cancel())
          screen.innerHTML = first
          screen.classList.remove('lv-talk')
          fadeIn(screen.querySelectorAll(TEXT))
          dirty = false
        }
        const next = () => {
          if (i < turns.length) {
            dirty = true
            return at(step(card, turns[i++], at), next)
          }
          // 대화가 끝나면 글을 지우고 처음 화면에서 다시 이어 간다.
          i = 0
          fadeOut(screen.querySelectorAll(TEXT))
          at(0.3, reset)
          at(1.3, next)
        }
        card.classList.add('lv-run')
        at(0.3, next)
        runs.set(card, () => {
          timers.forEach(clearTimeout)
          card.classList.remove('lv-run')
          if (dirty) reset()
        })
      }
      const stop = (card: HTMLElement) => {
        runs.get(card)?.()
        runs.delete(card)
      }
      if (matchMedia('(hover: hover)').matches) {
        cards.forEach((c) => {
          c.addEventListener('pointerenter', () => start(c))
          c.addEventListener('pointerleave', () => stop(c))
        })
      } else {
        const io = new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? start : stop)(e.target as HTMLElement)), { threshold: 0.6 })
        cards.forEach((c) => io.observe(c))
      }
    }
  </script>
  {/* 요금 카드(빌드 후 인라인, 1KB 안팎): 마우스가 있으면 마우스 쪽으로 살짝 기울고 빛이 반사된다. 카드가 화면에 들어오면
      is-seen을 붙여 일일권 도장이 찍히고, 마우스가 없는 화면에서는 빛이 한 번 스쳐 지나간다(CSS). 움직임 줄이기 설정이면 없음.
      위 스크립트와 나눠 두어 둘 다 인라인 한도(4KB) 안에 든다. */}
  <script>
    const plans = document.querySelectorAll<HTMLElement>('.plan')
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return
        e.target.classList.add('is-seen')
        io.unobserve(e.target)
      }), { threshold: 0.6 })
      plans.forEach((p) => {
        p.classList.add('is-wait')
        io.observe(p)
      })
    }
    if (matchMedia('(hover: hover)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      for (const card of plans) {
        let raf = 0
        card.addEventListener('pointermove', (e) => {
          cancelAnimationFrame(raf)
          raf = requestAnimationFrame(() => {
            const r = card.getBoundingClientRect()
            const x = (e.clientX - r.left) / r.width
            const y = (e.clientY - r.top) / r.height
            card.classList.add('is-tilt')
            card.style.setProperty('--x', `${(x * 100).toFixed(1)}%`)
            card.style.setProperty('--y', `${(y * 100).toFixed(1)}%`)
            card.style.setProperty('--rx', `${((0.5 - y) * 8).toFixed(2)}deg`)
            card.style.setProperty('--ry', `${((x - 0.5) * 10).toFixed(2)}deg`)
          })
        })
        card.addEventListener('pointerleave', () => {
          cancelAnimationFrame(raf)
          card.classList.remove('is-tilt')
          card.style.removeProperty('--rx')
          card.style.removeProperty('--ry')
        })
      }
    }
  </script>
</Base>
