---
// 약관·개인정보·환불 페이지의 공통 틀(영어·한국어). 머리 막대, 제목, 목차(있으면), 본문, 바닥 줄.
import Base from '../layouts/Base.astro'
import Mark from './Mark.astro'
import Business from './Business.astro'
import { COMPANY } from '../site'
import { en } from '../i18n/en'
import { ko } from '../i18n/ko'
import '../styles/site.css'
import '../styles/legal.css'

type Page = 'privacy' | 'terms' | 'refund'
type Lang = 'en' | 'ko'
interface Props {
  lang: Lang
  page: Page
  title: string
  metaTitle: string
  metaDescription: string
  updated: string
  /** [id, 목차 이름]. 없으면 목차 없이 한 단으로 놓는다. */
  toc?: [string, string][]
}
const { lang, page, title, metaTitle, metaDescription, updated, toc } = Astro.props
const ui = {
  en: {
    dict: en,
    nav: { privacy: 'Privacy', terms: 'Terms', refund: 'Refunds' },
    foot: { privacy: 'Privacy Policy', terms: 'Terms of Service', refund: 'Refund Policy' },
    toc: 'On this page',
    home: 'Tolkmeet home',
    other: { lang: 'ko', label: '한국어' },
  },
  ko: {
    dict: ko,
    nav: { privacy: '개인정보', terms: '이용약관', refund: '환불' },
    foot: { privacy: '개인정보처리방침', terms: '이용약관', refund: '환불 정책' },
    toc: '목차',
    home: 'Tolkmeet 홈',
    other: { lang: 'en', label: 'English' },
  },
}[lang]
const pages: Page[] = ['privacy', 'terms', 'refund']
const href = (p: Page, l: Lang = lang) => (l === 'ko' ? `/ko/${p}/` : `/${p}/`)
const otherHref = href(page, ui.other.lang as Lang)
// 검색에 올린다. 언어 대안은 이 페이지의 영어·한국어 짝이고, 영어판이 x-default다.
const t = { ...ui.dict, metaTitle, metaDescription, path: href(page) }
const alternates: [string, string][] = [['en', href(page, 'en')], ['ko', href(page, 'ko')]]
---
<Base t={t} alternates={alternates} ogAlt={ui.dict.metaTitle}>
  <div class="legal">
    <a class="skip" href="#legal-main">{ui.dict.skipToContent}</a>
    <header>
    <nav class="legal-top" aria-label={ui.dict.navLabel}>
      <a class="brand" href={lang === 'ko' ? '/ko/' : '/'} aria-label={ui.home}><Mark size={22} /><span>tolkmeet</span></a>
      <span class="legal-links">
        {pages.map((p) => <a href={href(p)} aria-current={p === page ? 'page' : undefined}>{ui.nav[p]}</a>)}
      </span>
    </nav>
    </header>

    <main id="legal-main">
      {toc ? (
        <>
          <header class="legal-head">
            <h1>{title}</h1>
            <p class="legal-date">{updated} · <a class="legal-lang" href={otherHref} lang={ui.other.lang} hreflang={ui.other.lang}>{ui.other.label}</a></p>
          </header>
          <div class="legal-body has-toc">
            <nav class="legal-toc" aria-label={ui.toc}>
              <span class="legal-toc-title">{ui.toc}</span>
              {toc.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
            </nav>
            <article class="legal-text"><slot /></article>
          </div>
        </>
      ) : (
        <article class="legal-text legal-single">
          <h1>{title}</h1>
          <p class="legal-date">{updated} · <a class="legal-lang" href={otherHref} lang={ui.other.lang} hreflang={ui.other.lang}>{ui.other.label}</a></p>
          <slot />
        </article>
      )}
    </main>

    <footer class="legal-foot">
      <Business dict={ui.dict} class="legal-biz" />
      © 2026 {COMPANY.name}{pages.map((p) => <> · <a href={href(p)}>{ui.foot[p]}</a></>)} · <a class="legal-lang" href={otherHref} lang={ui.other.lang} hreflang={ui.other.lang}>{ui.other.label}</a>
    </footer>
  </div>
</Base>
