---
import type { Dict } from '../i18n/en'
import { LOCALES, SITE_URL } from '../site'
// 스타일은 페이지마다 따로 가져온다: 소개 페이지는 landing.css, 약관·없는 페이지는 site.css(테마 토큰 포함).

interface Props {
  t: Dict
  /** 검색 결과용 구조화 데이터(JSON-LD) */
  jsonLd?: object[]
  /** 없는 페이지 등: 검색에 올리지 않고 대표 주소·언어 대안도 걸지 않는다. */
  noindex?: boolean
  /** 밝은 화면만 쓰는 페이지(소개 페이지): 테마 스크립트 없이 data-theme="light"로 고정한다. */
  lightOnly?: boolean
}
const { t, jsonLd = [], noindex = false, lightOnly = false } = Astro.props
const canonical = new URL(t.path, SITE_URL).href
const ogImage = new URL(`/og-${t.lang}.png`, SITE_URL).href
const ogLocale = { en: 'en_US', ko: 'ko_KR', ja: 'ja_JP' }[t.lang]
---
<!doctype html>
<html lang={t.htmlLang} data-theme={lightOnly ? 'light' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 그리기 전에 테마(저장된 선택, 없으면 시스템)와 움직임 허용 여부를 정한다. 깜빡임 없이 첫 화면이 맞는 색으로 뜬다. */}
    {!lightOnly && <script is:inline>
      ;(() => {
        const d = document.documentElement
        try {
          const theme = localStorage.getItem('tolkmeet.theme')
          if (theme === 'light' || theme === 'dark') d.dataset.theme = theme
        } catch {}
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion')
      })()
    </script>}
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDescription} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {LOCALES.map((l) => <link rel="alternate" hreflang={l.lang} href={new URL(l.path, SITE_URL).href} />)}
        <link rel="alternate" hreflang="x-default" href={new URL('/', SITE_URL).href} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tolkmeet" />
    <meta property="og:title" content={t.metaTitle} />
    <meta property="og:description" content={t.metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="color-scheme" content={lightOnly ? 'light' : 'light dark'} />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    {/* 앱과 같은 글꼴. dynamic subset이라 화면에 쓰인 글자 범위의 조각만 받는다. crossorigin으로 preconnect한 연결을 같이 쓴다. */}
    <link rel="stylesheet" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-jp-dynamic-subset.min.css" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
